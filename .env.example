RESEND_API_KEY=
FROM_EMAIL=
ADMIN_EMAIL=
ADMIN_NAME=

# Event details — EVENT_DATE (YYYY-MM-DD) also drives the reminder schedule below
EVENT_NAME=
EVENT_DATE=
EVENT_TIME=
EVENT_LOCATION=
EVENT_DESCRIPTION=

ADMIN_DASHBOARD_KEY=
PORT=

# Reminder emails are scheduled automatically off EVENT_DATE — no extra config needed:
#   One Week Reminder  — sent at 10:00 AM, 7 days before EVENT_DATE
#   Day Before Reminder — sent at 10:00 AM, 1 day before EVENT_DATE
#   Day Of Reminder     — sent at 9:00 AM, on EVENT_DATE
# Each reminder is sent at most once per registrant (tracked in reminders-sent.json).
# Set TEST_REMINDER_MODE=true to force-send the one-week and day-before reminders
# immediately on every check, ignoring EVENT_DATE — useful for local testing.
# GET /test-one-week-reminder?key=<ADMIN_DASHBOARD_KEY> sends the one-week reminder on demand.
TEST_REMINDER_MODE=
